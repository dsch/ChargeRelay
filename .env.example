# Database connection
# Built-in Postgres: set COMPOSE_PROFILES=local-db and DB_HOST=postgres
# External database: leave COMPOSE_PROFILES empty, set DB_HOST to your server
COMPOSE_PROFILES=local-db
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ocpp
DB_USER=ocpp
DB_PASSWORD=change-me

# UI password gate – leave empty to disable (no login screen shown)
UI_PASSWORD=

# Firmware update (Stations tab). Disabled while FW_PUBLIC_BASE_URL is empty.
# FW_PUBLIC_BASE_URL must be an address the CHARGER can reach (it downloads the
# file from <FW_PUBLIC_BASE_URL>/api/firmware/download/...), e.g. the frontend URL.
FW_PUBLIC_BASE_URL=
FW_MAX_UPLOAD_MB=100

# Default UI language: "de" (German) or "en" (English)
DEFAULT_LOCALE=de

# SMTP settings for e-mail report delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=ocpp-reports@example.com
